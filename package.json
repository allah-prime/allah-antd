{
  "name": "@allahjs/antd",
  "version": "0.0.1",
  "description": "基于 antd v6 封装的 React 业务组件库",
  "homepage": "https://allah-prime.github.io/allah-antd/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allah-prime/allah-antd.git"
  },
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.less"
  ],
  "scripts": {
    "build": "father build",
    "build:watch": "father dev",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "docs:preview": "dumi preview",
    "doctor": "father doctor",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js}\" --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "father doctor && npm run build",
    "publishNpm": "father doctor && npm run build && npm publish --access public --registry=https://registry.npmjs.org/"
  },
  "dependencies": {
    "@allahjs/tiptap": "2.3.0",
    "@allahjs/utils": "link:../allah-utils",
    "@ant-design/icons": "6.3.4",
    "@ant-design/pro-components": "3.1.14-7",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "7.0.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@monaco-editor/loader": "1.7.0",
    "@uiw/react-md-editor": "4.0.11",
    "ahooks": "3.9.6",
    "antd-mobile": "5.42.2",
    "antd-mobile-icons": "0.3.0",
    "axios": "1.4.0",
    "classnames": "2.5.1",
    "dayjs": "1.11.19",
    "diff": "5.1.0",
    "lodash": "4.18.1",
    "monaco-editor": "0.56.0",
    "numeral": "2.0.6",
    "prettier": "3.9.7",
    "qs": "6.16.0",
    "rc-menu": "9.16.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1"
  },
  "peerDependencies": {
    "antd": ">=6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@allahjs/eslint": "1.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/lodash": "4.17.21",
    "@types/numeral": "2.0.5",
    "@types/qs": "6.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "antd": "6.6.5",
    "dumi": "2.4.49",
    "eslint": "9.39.2",
    "father": "4.6.36",
    "less": "4.5.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.8.0",
  "publishConfig": {
    "access": "public"
  },
  "authors": [
    "allahbin <16008@theling.cn>"
  ]
}
